# ==========================================
# LibreOffice WASM: Conversion-only Build (DRAFT — pending GHA verify)
# ==========================================
# GOALS:
#   - Full import/export format support (DOCX, XLSX, PPTX, etc.) KEPT
#   - NO editor / rendering-tile / interaction / a11y / callback shims
#   - Smaller soffice.wasm than the baseline full build
#   - First gate: test.docx → pdf must pass
#
# This is a DRAFT. Items marked `# PENDING-VERIFY` may break WASM build or
# format filters and must be confirmed one-by-one in the GHA conversion-only
# build. If a switch breaks the gate, revert just that switch.
#
# Derived from build/autogen.input (baseline). Diff vs baseline is the
# added --disable-* block below; full-format items (--with-main-module=all,
# --enable-pdfimport/pdfium, cairo-canvas/skia) are UNCHANGED.
# ==========================================

--host=wasm32-local-emscripten
--with-main-module=all
--disable-gui

# ==========================================
# Disable GUI toolkits, OS deps (same as baseline)
# Note: Do NOT disable cairo-canvas or skia - needed for PDF/SVG rendering
# ==========================================
--disable-kf5
--disable-kf6
--disable-gtk3
--disable-gtk4
--disable-qt5
--disable-qt6
--disable-gstreamer-1-0
--disable-sdremote
--disable-sdremote-bluetooth
--disable-dbus
--disable-cups
--disable-randr

# ==========================================
# Remove scripting/automation (same as baseline)
# ==========================================
--disable-scripting
--disable-librelogo
--disable-odk

# ==========================================
# Disable database connectors (same as baseline)
# ==========================================
--disable-database-connectivity
--disable-mariadb-sdbc
--disable-postgresql-sdbc
--disable-firebird-sdbc
--disable-ldap
--without-krb5
--without-gssapi

# ==========================================
# Disable updates / crash reporter / telemetry (same as baseline)
# ==========================================
--disable-online-update
--disable-crashdump
--disable-cve-tests

# ==========================================
# Crypto not needed for conversion (same as baseline)
# ==========================================
--disable-nss

# ==========================================
# Remove unused extras (same as baseline)
# ==========================================
--without-java
--without-doxygen
--without-helppack-integration
--without-myspell-dicts
--with-lang=en-US

# ==========================================
# WASM build optimizations (same as baseline)
# ==========================================
--enable-optimized
--enable-wasm-strip
--disable-debug
--enable-sal-log

# ==========================================
# PDF import/export support (same as baseline — KEEP for docx→pdf gate)
# ==========================================
--enable-pdfimport
--enable-pdfium
--disable-poppler

# ==========================================
# CONVERSION-ONLY ADDITIONS (vs baseline)
# Everything below is NEW and PENDING-VERIFY.
# ==========================================

# Media playback — conversion does not need avmedia. PENDING-VERIFY.
--disable-avmedia

# GLib IO — conversion does not need gio. PENDING-VERIFY.
--disable-gio

# Extensions — conversion does not run extensions. PENDING-VERIFY that this
# does not break filter registration (filters are not extensions).
--disable-extensions
--disable-extension-integration
--disable-extension-update

# Base report builder — not conversion. PENDING-VERIFY.
--disable-report-builder

# Solver — Calc conversion does not need lpsolve/coinmp. PENDING-VERIFY that
# xlsx import still works without them.
--disable-lpsolve
--disable-coinmp

# GPU compute — not needed. PENDING-VERIFY.
--disable-opencl

# Help system XML — not needed. PENDING-VERIFY.
--disable-xmlhelp

# Lotus Word Pro import filter — cold format. PENDING-VERIFY.
--disable-lotuswordpro

# Community flavor packaging — not needed. PENDING-VERIFY.
--disable-community-flavor

# Link-time optimization — shrinks binary at build-time cost. PENDING-VERIFY
# (lto can fail on some WASM toolchain versions; revert if it breaks build).
--enable-lto
